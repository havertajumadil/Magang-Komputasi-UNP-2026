# sci.mplstyle
# Style sheet Matplotlib untuk standarisasi grafik publikasi/laporan WS2 monolayer

figure.figsize       : 5, 4
figure.dpi           : 150
savefig.dpi          : 300
savefig.bbox         : tight

font.family          : serif
font.size            : 11

axes.labelsize       : 12
axes.titlesize       : 12
axes.linewidth       : 1.0
axes.grid            : False

xtick.direction       : in
ytick.direction       : in
xtick.top             : True
ytick.right           : True
xtick.major.size      : 5
ytick.major.size      : 5
xtick.minor.visible   : True
ytick.minor.visible   : True
xtick.minor.size      : 2.5
ytick.minor.size      : 2.5

lines.linewidth       : 1.5
lines.markersize      : 5

legend.frameon        : False
legend.fontsize       : 10

axes.prop_cycle       : cycler('color', ['1f77b4', 'd62728', '2ca02c', 'ff7f0e', '9467bd'])
